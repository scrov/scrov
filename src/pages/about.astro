    function evaluatePassEntropy(pass) {
      const label = document.getElementById('auth-entropy-label');
      if (!label) return;
      let score = 0;
      if (pass.length >= 8) score += 30;
      if (/[A-Z]/.test(pass)) score += 20;
      if (/[0-9]/.test(pass)) score += 20;
      if (/[^A-Za-z0-9]/.test(pass)) score += 30;

      label.textContent = (score >= 70) ? `Entropy: ${score} bits (Strong)` : `Entropy: ${score} bits (Moderate)`;
      label.className = (score >= 70) ? 'text-[9px] text-matrix-bright' : 'text-[9px] text-amber-400';
    }

    function handleAuthSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('auth-input-email').value.trim();
      const name = document.getElementById('auth-input-name').value.trim() || 'Alex Mercier';

      const payload = {
        sub: email,
        name: name,
        role: "ROLE_ADMIN",
        iss: "scrov-auth-v3",
        mcp_scopes: ["gcloud", "workspace", "google_ads", "admob", "adsense", "github", "cloudflare"],
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 86400
      };

      const header = { alg: "HS256", typ: "JWT" };
      const token = btoa(JSON.stringify(header)) + "." + btoa(JSON.stringify(payload)) + ".sig_" + Math.random().toString(36).substring(2, 10);

      state.currentUser = { email, name, role: payload.role };
      state.activeJwtToken = token;

      localStorage.setItem('scrov_auth_user', JSON.stringify(state.currentUser));
      localStorage.setItem('scrov_jwt_token', token);

      updateAuthUi();
      logTerminal(`\x1b[32m[auth] User ${email} authenticated successfully. JWT token issued.\x1b[0m`);
      dispatchGtagEvent(activeAuthTab === 'signin' ? 'login' : 'sign_up', { method: 'jwt_bearer', email });
      toast(`Welcome, ${name}`);
      setTimeout(closeAuthModal, 600);
    }

    function triggerOAuth(provider) {
      const email = `engineer.${provider}@scrov.app`;
      const name = `${provider.toUpperCase()} Dev`;
      const payload = {
        sub: email,
        name: name,
        provider: provider,
        role: "ROLE_ARCHITECT",
        iss: `https://accounts.${provider}.com`,
        iat: Math.floor(Date.now() / 1000),
        exp: Math.floor(Date.now() / 1000) + 86400
      };

      const header = { alg: "RS256", typ: "JWT" };
      const token = btoa(JSON.stringify(header)) + "." + btoa(JSON.stringify(payload)) + ".sig_" + Math.random().toString(36).substring(2, 10);

      state.currentUser = { email, name, role: payload.role, provider };
      state.activeJwtToken = token;

      localStorage.setItem('scrov_auth_user', JSON.stringify(state.currentUser));
      localStorage.setItem('scrov_jwt_token', token);

      updateAuthUi();
      logTerminal(`\x1b[32m[oauth2] Authenticated via ${provider.toUpperCase()}.\x1b[0m`);
      dispatchGtagEvent('login', { method: provider, email });
      toast(`OAuth Success: ${provider.toUpperCase()}`);
      setTimeout(closeAuthModal, 600);
    }

