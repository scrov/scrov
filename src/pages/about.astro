    (function ensureTerminalConstructors() {
      if (typeof window.Terminal === 'undefined') {
        window.Terminal = class UniversalTerminal {
          constructor(options = {}) {
            this.options = options;
            this.element = null;
            this.dataListeners = [];
            this.isFallback = true;
          }
          open(container) {
            this.element = container;
            this._renderDom();
          }
          loadAddon() {}
          onData(fn) {
            this.dataListeners.push(fn);
          }
          write(text) {
            this._append(text);
          }
          writeln(text) {
            this._append(text + '\r\n');
          }
          clear() {
            const out = this.element ? this.element.querySelector('.term-universal-out') : null;
            if (out) out.innerHTML = '';
          }
          _renderDom() {
            if (!this.element) return;
            this.element.innerHTML = `
              <div class="w-full h-full flex flex-col font-mono text-xs text-matrix-bright select-text overflow-hidden p-2">
                <div class="term-universal-out flex-1 overflow-y-auto space-y-0.5 leading-relaxed pr-1"></div>
                <div class="flex items-center gap-1.5 pt-1 border-t border-matrix-border shrink-0">
                  <span class="text-matrix-neon font-bold">root@scrov-matrix</span><span class="text-emerald-600">:</span><span class="text-emerald-400 font-bold">/workspace</span><span class="text-matrix-bright font-bold">#</span>
                  <input type="text" class="term-universal-in flex-1 bg-transparent text-matrix-bright outline-none font-mono text-xs border-none p-0 focus:ring-0" autocomplete="off" spellcheck="false" autofocus />
                </div>
              </div>
            `;
            const out = this.element.querySelector('.term-universal-out');
            const inp = this.element.querySelector('.term-universal-in');
            const history = [];
            let hIdx = -1;

            if (inp) {
              inp.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                  const val = inp.value;
                  inp.value = '';
                  if (val.trim()) {
                    history.push(val);
                    hIdx = history.length;
                  }
                  for (const ch of val) {
                    this.dataListeners.forEach(fn => fn(ch));
                  }
                  this.dataListeners.forEach(fn => fn('\r'));
                } else if (e.key === 'ArrowUp' && history.length > 0 && hIdx > 0) {
                  e.preventDefault();
                  hIdx--;
                  inp.value = history[hIdx];
                } else if (e.key === 'ArrowDown') {
                  e.preventDefault();
                  if (hIdx < history.length - 1) {
                    hIdx++;
                    inp.value = history[hIdx];
                  } else {
                    hIdx = history.length;
                    inp.value = '';
                  }
                }
              });

              this.element.addEventListener('click', () => inp.focus());
            }
          }
          _append(text) {
            const out = this.element ? this.element.querySelector('.term-universal-out') : null;
            if (!out) return;
            const div = document.createElement('div');
            div.className = 'break-all leading-snug';
            div.innerHTML = this._ansiToHtml(text);
            out.appendChild(div);
            out.scrollTop = out.scrollHeight;
          }
          _ansiToHtml(str) {
            if (!str) return '';
            const map = {
              '1;32': 'text-matrix-bright font-bold',
              '32': 'text-matrix-bright',
              '1;36': 'text-matrix-neon font-bold',
              '36': 'text-matrix-neon',
              '1;34': 'text-emerald-400 font-bold',
              '34': 'text-emerald-400',
              '1;33': 'text-matrix-amber font-bold',
              '33': 'text-matrix-amber',
              '31': 'text-matrix-rose',
              '1;37': 'text-white font-bold',
              '90': 'text-emerald-700',
              '0': ''
            };
            let escaped = str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            escaped = escaped.replace(/\x1b\[([0-9;]+)m/g, (_, code) => {
              if (code === '0') return '</span>';
              return `<span class="${map[code] || 'text-emerald-300'}">`;
            });
            return escaped.replace(/\r\n/g, '<br>').replace(/\n/g, '<br>');
          }
        };
      }
      if (typeof window.FitAddon === 'undefined') {
        window.FitAddon = {
          FitAddon: class { fit() {} }
        };
      }
