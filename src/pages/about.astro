    function selectRestEndpointWithHeaders(method, url, headers) {
      document.getElementById('repl-method-select').value = method;
      document.getElementById('repl-url-input').value = url;
      document.getElementById('repl-payload-editor').value = JSON.stringify({
        headers: headers,
        probe: "scrov-agent-runner",
        timestamp: new Date().toISOString()
      }, null, 2);
      switchCenterTab('tab-restrepl-logger');
      dispatchReplRequest();
    }

    function dispatchReplRequest() {
      const method = document.getElementById('repl-method-select').value;
      const url = document.getElementById('repl-url-input').value;
      const payloadEditor = document.getElementById('repl-payload-editor').value;
      const resBadge = document.getElementById('repl-status-badge');
      const latBadge = document.getElementById('repl-latency-badge');
      const resInfo = document.getElementById('repl-response-info');
      const resOutput = document.getElementById('repl-response-output');

      resBadge.textContent = 'CALLING...';
      resBadge.className = 'text-[9px] px-1.5 py-0.2 rounded bg-amber-950 text-amber-300 border border-amber-800';

      const start = performance.now();
      setTimeout(() => {
        const latency = (performance.now() - start).toFixed(1);
        latBadge.textContent = `Latency: ${latency}ms`;
        resBadge.textContent = '200 OK';
        resBadge.className = 'text-[9px] px-1.5 py-0.2 rounded bg-emerald-950 text-matrix-bright border border-matrix-border';
        resInfo.textContent = `200 OK (${latency}ms)`;

        let parsedBody = {};
        try { parsedBody = JSON.parse(payloadEditor); } catch(e) {}

        const responseMock = {
          endpoint: url,
          http_method: method,
          status: 200,
          latency_ms: parseFloat(latency),
          cluster: "scrov-kind-production",
          headers: {
            "content-type": "application/json",
            "x-gateway-proxy": "Envoy/Nginx/Wasmoon",
            "x-github-api-version": url.includes('github') ? "2026-03-10" : undefined,
            "cf-ray": url.includes('cloudflare') ? "8df30291ba40-YUL" : undefined,
            "x-law25-consent": state.consent.analytics ? "granted" : "denied"
          },
          data: {
            success: true,
            received: parsedBody,
            cluster_telemetry: {
              active_nodes: 4,
              vfs_entries: Object.keys(state.vfs.storage || {}).length
            }
          }
        };

        resOutput.textContent = JSON.stringify(responseMock, null, 2);
        logTerminal(`\x1b[32m[rest] ${method} ${url} -> 200 OK (${latency}ms)\x1b[0m`);
      }, 140);
    }

    function generateReplCurl() {
      const method = document.getElementById('repl-method-select').value;
      const url = document.getElementById('repl-url-input').value;
      let headersPart = '-H "Content-Type: application/json"';
      if (url.includes('github')) {
        headersPart += ' -H "X-GitHub-Api-Version: 2026-03-10" -H "Accept: application/vnd.github+json"';
      }
      const curl = `curl -i -X ${method} "${url.startsWith('http') ? url : 'https://gateway.scrov.internal' + url}" ${headersPart}`;
      if (navigator.clipboard) navigator.clipboard.writeText(curl);
      logTerminal(`\x1b[33m[curl] Copied to clipboard:\x1b[0m ${curl}`);
      toast("cURL Command Copied");
    }

    // 5. Clipboard Snippets Logger
