    function closeNewFileModal() { document.getElementById('new-file-modal').classList.add('hidden'); }

    function confirmCreateVfsFile() {
      const folderVal = document.getElementById('modal-file-folder').value.replace(/\//g, '').replace('dav', '');
      const rawName = document.getElementById('modal-file-name').value.trim();
      if (!rawName) return;

      const ext = rawName.split('.').pop() || 'txt';
      const langMap = {
        'lsp': 'lua', 'lua': 'lua', 'conf': 'nginx', 'sql': 'sql',
        'json': 'json', 'jsonc': 'json', 'xml': 'xml', 'txt': 'plaintext', 'md': 'markdown', 'js': 'javascript'
      };

      if (!state.vfs[folderVal]) state.vfs[folderVal] = {};
      state.vfs[folderVal][rawName] = {
        lang: langMap[ext] || 'plaintext',
        content: `# New Virtual Entry: /dav/${folderVal}/${rawName}\n`
      };

      saveVfsToLocalStorage();
      renderVfsTree();
      closeNewFileModal();
      document.getElementById('modal-file-name').value = '';
      selectVfsFile(folderVal, rawName);
      logTerminal(`\x1b[32m[webdav] Dispatched HTTP MKCOL/PUT -> /dav/${folderVal}/${rawName} (201 Created)\x1b[0m`);
      toast(`Created /dav/${folderVal}/${rawName}`);
    }

