            <div class="pl-2 border-l border-matrix-border/70 space-y-0.5 ml-1.5">
        `;

        for (const [filename, fileObj] of Object.entries(files)) {
          const isActive = (state.activeVfsPath.folder === folder && state.activeVfsPath.file === filename);
