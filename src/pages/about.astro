---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="Lorem ipsum dolor sit amet"
	pubDate={new Date('August 08 2021')}
	heroImage="/blog-placeholder-about.jpg"
>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Scrov Studio Flow — SOTA Matrix Cockpit &amp; MCP Monorepo Mesh</title>

  <!-- Manifest & Web App Meta -->
  <meta name="theme-color" content="#030704">
  <meta name="description" content="Unified Matrix PWA Cockpit, Web REPL Box, MCP Agent Runner, and Monorepo Orchestrator">
  <link rel="manifest" href="data:application/manifest+json;base64,eyJuYW1lIjoiU2Nyb3YgU3R1ZGlvIEZsb3ciLCJzaG9ydF9uYW1lIjoiU2Nyb3YiLCJzdGFydF91cmwiOiIvIiwiZGlzcGxheSI6InN0YW5kYWxvbmUiLCJiYWNrZ3JvdW5kX2NvbG9yIjoiIzAzMDcwNCIsInRoZW1lX2NvbG9yIjoiIzAwZmY2NiJ9">

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Xterm.js & Addons for Terminal Dock (with multi-CDN fallback) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/xterm/5.3.0/xterm.min.css">
  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>

  <!-- 0. Global Shield against read-only WebSocket / XHR property assignment in iframes & Firefox -->
  <script>
    window.addEventListener('error', function(e) {
      if (e && e.message && (
        e.message.indexOf('WebSocket') !== -1 ||
        e.message.indexOf('read-only') !== -1 ||
        e.message.indexOf('anonymous define call') !== -1
      )) {
        console.warn('[Global Protective Shield] Suppressed non-fatal third-party script error:', e.message);
        if (typeof e.preventDefault === 'function') e.preventDefault();
        if (typeof e.stopPropagation === 'function') e.stopPropagation();
        return true;
      }
    }, true);

    (function protectGlobalNetworkAPIs() {
      ['WebSocket', 'XMLHttpRequest'].forEach(function(prop) {
        try {
          var real = window[prop];
          if (typeof real !== 'undefined') {
            var current = real;
            Object.defineProperty(window, prop, {
              configurable: true,
              enumerable: true,
              get: function() { return current; },
              set: function(val) { current = val; }
            });
          }
        } catch (e) {
          console.warn('[Global Shield] Could not redefine ' + prop, e);
        }
      });
    })();
  </script>

  <!-- 1. Eruda Mobile Browser Console & DevTools -->
  <script src="https://cdn.jsdelivr.net/npm/eruda"></script><style type="text/css">.eruda-search-highlight-block{display:inline}.eruda-search-highlight-block .eruda-keyword{background:#fffbe5;color:#5c5c00}</style>

  <!-- 2. SQLite WASM Engine (sql.js for nb.sh notebook) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js"></script>

  <!-- 3. Monaco Editor AMD Loader & AMD Protective Shield -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.js"></script>
  <script>
    (function protectMonacoAmdLoader() {
      if (typeof window.define === 'function' && window.define.amd) {
        window.__monaco_define = window.define;
        window.__monaco_require = window.require;
        const originalDefine = window.define;

        const safeDefine = function(name, deps, callback) {
          if (typeof name !== 'string') {
            try {
              return originalDefine.apply(this, arguments);
            } catch (err) {
              if (err && err.message && err.message.indexOf('anonymous define call') !== -1) {
                console.warn('[Monaco AMD Shield] Intercepted anonymous define collision:', err.message);
                return;
              }
              throw err;
            }
          }
          return originalDefine.apply(this, arguments);
        };

        for (const prop in originalDefine) {
          if (Object.prototype.hasOwnProperty.call(originalDefine, prop)) {
            safeDefine[prop] = originalDefine[prop];
          }
        }
        safeDefine.amd = originalDefine.amd;
        window.define = safeDefine;
      }
    })();
  </script>

  <!-- Tailwind Custom Matrix Hacker Theme Configuration -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            matrix: {
              black: '#020502',
              bg: '#030704',
              panel: '#061209',
              card: '#091c0e',
              border: '#14381b',
              glow: '#00ff66',
              dim: '#15803d',
              bright: '#00ff66',
              neon: '#00ffcc',
              amber: '#f59e0b',
              rose: '#f43f5e',
              cyan: '#06b6d4',
              purple: '#a855f7'
            }
          },
          fontFamily: {
            mono: ['JetBrains Mono', 'Fira Code', 'Menlo', 'Consolas', 'Courier New', 'monospace'],
            sans: ['Inter', 'Segoe UI', 'system-ui', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    /* Custom Matrix Scrollbars */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #030704; }
    ::-webkit-scrollbar-thumb { background: #14381b; border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: #00ff66; }

    /* CRT Scanlines & Phosphor Glow Effects */
    .scanline {
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(0, 255, 100, 0.03), rgba(0, 0, 0, 0.01), rgba(0, 255, 100, 0.03));
      background-size: 100% 3px, 6px 100%;
      pointer-events: none;
    }
    .matrix-glow {
      text-shadow: 0 0 8px rgba(0, 255, 102, 0.6);
    }
    .matrix-border-glow {
      box-shadow: 0 0 10px rgba(0, 255, 102, 0.25), inset 0 0 8px rgba(0, 255, 102, 0.1);
    }
    .pulse-matrix {
      animation: pulseGlow 1.8s infinite ease-in-out;
    }
    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); opacity: 0.95; filter: drop-shadow(0 0 4px #00ff66); }
      50% { transform: scale(1.25); opacity: 0.4; filter: drop-shadow(0 0 8px #00ffcc); }
    }
  </style>
