    // 11. XTerm Terminal Dock
    function initXtermTerminal() {
      const termContainer = document.getElementById('xterm-container');
      if (!termContainer) return;

      try {
        const TermConstructor = window.Terminal || Terminal;
        state.terminal = new TermConstructor({
          cursorBlink: true,
          fontFamily: 'JetBrains Mono, Menlo, monospace',
          fontSize: 12,
          theme: {
            background: '#020502',
            foreground: '#00ff66',
            cursor: '#00ff66',
            black: '#061209',
            green: '#00ff66',
            cyan: '#00ffcc',
            yellow: '#f59e0b',
            magenta: '#f43f5e'
          }
        });

        const FitAddonClass = (typeof window.FitAddon !== 'undefined' && window.FitAddon.FitAddon) ||
                              (typeof FitAddon !== 'undefined' && FitAddon.FitAddon);
        if (FitAddonClass) {
          try {
            state.termFit = new FitAddonClass();
            state.terminal.loadAddon(state.termFit);
          } catch (e) {}
        }

        state.terminal.open(termContainer);
        if (state.termFit && typeof state.termFit.fit === 'function') {
          try { state.termFit.fit(); } catch(e) {}
        }

        window.addEventListener('resize', () => {
          if (state.termFit && typeof state.termFit.fit === 'function') {
            try { state.termFit.fit(); } catch(e) {}
          }
        });

        state.terminal.writeln('\x1b[1;32m[SCROV SOTA MATRIX TMUX PTY TERMINAL ACTIVE]\x1b[0m');
        state.terminal.writeln('\x1b[90mConnected to Envoy mesh, GitHub MCP (2026-03-10), Cloudflare Agent, and Gemini Enterprise.\x1b[0m');
        state.terminal.writeln('\x1b[90mType "\x1b[1;37mhelp\x1b[90m" for available commands.\x1b[0m\r\n');
        promptTerminal();

        let cmdBuffer = '';
        state.terminal.onData(data => {
          if (data === '\r') {
            state.terminal.write('\r\n');
            handleTerminalCmd(cmdBuffer.trim());
            cmdBuffer = '';
          } else if (data === '\u007F') {
            if (cmdBuffer.length > 0) {
              cmdBuffer = cmdBuffer.slice(0, -1);
              state.terminal.write('\b \b');
            }
          } else if (data >= ' ' || data === '\t') {
            cmdBuffer += data;
            state.terminal.write(data);
          }
        });
      } catch (err) {}
    }

    function promptTerminal() {
      if (!state.terminal?.isFallback) {
