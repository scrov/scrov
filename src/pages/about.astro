    function parseClipboardBuffer() {
      const raw = document.getElementById('clip-log-input').value;
      const lines = raw.split('\n').filter(l => l.trim().length > 0);
      state.parsedLogs = [];

      lines.forEach((line, idx) => {
        let level = 'INFO';
        let color = 'text-matrix-bright';
        if (line.includes('WARN')) { level = 'WARN'; color = 'text-amber-400'; }
        if (line.includes('ERR') || line.includes('ERROR')) { level = 'ERR'; color = 'text-rose-400'; }
        if (line.includes('DEBUG')) { level = 'DEBUG'; color = 'text-matrix-neon'; }

        state.parsedLogs.push({ id: idx + 1, raw: line, level, color });
      });

      renderParsedLogs();
      document.getElementById('clip-parser-count').textContent = `${state.parsedLogs.length} events indexed`;
      indexLogsIntoSqlite();
    }

    function renderParsedLogs(filteredLogs = null) {
      const resultsContainer = document.getElementById('clip-parsed-results');
      const list = filteredLogs || state.parsedLogs;

      if (list.length === 0) {
        resultsContainer.innerHTML = '<span class="text-emerald-700">No logs matching filter.</span>';
        return;
      }

      resultsContainer.innerHTML = list.map(item => `
        <div class="p-1 rounded bg-matrix-panel border border-matrix-border flex items-start justify-between gap-1 group">
          <div class="truncate flex-1">
            <span class="text-[9px] px-1 bg-matrix-black border border-matrix-border rounded ${item.color} font-bold mr-1">${item.level}</span>
            <span class="text-emerald-300">${escapeHtml(item.raw)}</span>
          </div>
          <button onclick="copyLineSnippet('${escapeHtml(item.raw)}')" title="Copy log snippet" class="text-emerald-600 hover:text-matrix-bright shrink-0">
            <i data-lucide="copy" class="w-3 h-3"></i>
          </button>
        </div>
      `).join('');
      lucide.createIcons();
    }

    function filterLogs(lvl) {
      if (lvl === 'ALL') renderParsedLogs();
      else renderParsedLogs(state.parsedLogs.filter(l => l.level === lvl));
    }

    function clearAllLogs() {
      document.getElementById('clip-log-input').value = '';
      state.parsedLogs = [];
      renderParsedLogs();
      document.getElementById('clip-parser-count').textContent = '0 events';
      toast("Cleared Log Buffer");
    }

    function copyLineSnippet(text) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text);
        logTerminal(`\x1b[32m[xclip] Copied snippet to system clipboard.\x1b[0m`);
      }
      toast("Snippet Copied");
    }

    // 6. SQLite Engine
    async function initSqliteEngine() {
      try {
        if (typeof initSqlJs !== 'undefined') {
          const SQL = await initSqlJs({
            locateFile: file => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${file}`
          });
          state.sqlDb = new SQL.Database();
          state.sqlDb.run(state.vfs.storage['schema.sql'].content);
          execPgLiteQuery();
        }
      } catch (e) {}
    }

    function indexLogsIntoSqlite() {
      if (!state.sqlDb) return;
      try {
        state.sqlDb.run("CREATE TABLE IF NOT EXISTS parsed_logs (id INTEGER, raw TEXT, level TEXT);");
        state.sqlDb.run("DELETE FROM parsed_logs;");
        state.parsedLogs.forEach(l => {
          state.sqlDb.run("INSERT INTO parsed_logs (id, raw, level) VALUES (?, ?, ?);", [l.id, l.raw, l.level]);
        });
        queryParsedLogs();
      } catch(e) {}
    }

    function queryParsedLogs() {
      if (!state.sqlDb) return;
      const container = document.getElementById('parsed-logs-table-mount');
      try {
        const res = state.sqlDb.exec("SELECT id, level, raw FROM parsed_logs LIMIT 10;");
        if (res.length > 0) {
          let html = '<table class="w-full text-left border-collapse"><thead><tr class="text-emerald-500 border-b border-matrix-border">';
          res[0].columns.forEach(c => html += `<th class="py-0.5 px-1">${c}</th>`);
          html += '</tr></thead><tbody>';
          res[0].values.forEach(row => {
            html += `<tr class="border-b border-matrix-border/40 text-matrix-bright hover:bg-matrix-panel">
              <td class="py-0.5 px-1 text-emerald-500 font-mono">${row[0]}</td>
              <td class="py-0.5 px-1 text-amber-400 font-bold font-mono">${row[1]}</td>
              <td class="py-0.5 px-1 truncate max-w-xs font-mono">${row[2]}</td>
            </tr>`;
          });
          html += '</tbody></table>';
          container.innerHTML = html;
        } else {
          container.innerHTML = '<span class="p-1 text-emerald-600">Parsed logs table is empty.</span>';
        }
      } catch(e) {}
    }

    function execPgLiteQuery() {
      const q = document.getElementById('pglite-sql-input').value;
      const resContainer = document.getElementById('pglite-query-results');
      if (!state.sqlDb) {
        resContainer.innerHTML = '<span class="text-matrix-rose">PGlite engine initializing...</span>';
        return;
      }
      try {
        const res = state.sqlDb.exec(q);
        if (res.length > 0) {
          let html = '<table class="w-full text-left border-collapse"><thead><tr class="text-emerald-500 border-b border-matrix-border">';
          res[0].columns.forEach(c => html += `<th class="py-0.5 px-1">${c}</th>`);
          html += '</tr></thead><tbody>';
          res[0].values.forEach(row => {
            html += '<tr class="border-b border-matrix-border/40 text-matrix-bright">';
            row.forEach(v => html += `<td class="py-0.5 px-1">${v}</td>`);
            html += '</tr>';
          });
          html += '</tbody></table>';
          resContainer.innerHTML = html;
        } else {
          resContainer.innerHTML = '<span class="text-matrix-bright">Query executed. 0 rows returned.</span>';
        }
      } catch (e) {
        resContainer.innerHTML = `<span class="text-matrix-rose">Error: ${e.message}</span>`;
      }
    }

