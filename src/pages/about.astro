      if (keys.length === 0) {
        container.innerHTML = '<span class="text-emerald-700">Storage empty</span>';
        return;
      }
      container.innerHTML = keys.map(k => `
        <div class="p-1 bg-matrix-black rounded border border-matrix-border flex items-center justify-between">
          <span class="text-matrix-bright font-bold truncate max-w-[150px]">${k}</span>
          <span class="text-emerald-600">${(localStorage.getItem(k)||'').length}B</span>
        </div>
