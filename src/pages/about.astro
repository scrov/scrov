<body class="bg-matrix-bg text-emerald-300 font-mono h-screen w-screen overflow-hidden flex flex-col antialiased select-none enable-motion">
  <div class="scanline fixed inset-0 z-50 pointer-events-none"></div>

  <!-- ================= TOP MATRIX CONTROL PLANE & MONOREPO TOPOLOGY ================= -->
  <header class="h-11 border-b border-matrix-border bg-matrix-panel/90 backdrop-blur px-3 flex items-center justify-between shrink-0 z-40">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded bg-matrix-border border border-matrix-bright flex items-center justify-center font-mono font-bold text-matrix-bright text-xs shadow matrix-border-glow">
          ⚡
        </div>
        <span class="font-bold text-sm tracking-wider text-matrix-bright flex items-center gap-1.5 font-mono matrix-glow">
          SCROV <span class="text-[10px] text-matrix-neon font-light">SOTA.MATRIX.FLOW</span>
        </span>
      </div>

      <!-- Monorepo Multi-App Selector -->
      <div class="hidden lg:flex items-center gap-1 bg-matrix-black p-0.5 rounded border border-matrix-border text-[11px] font-mono">
        <button onclick="setActiveApp('apps/scrov')" id="btn-app-scrov" class="px-2 py-0.5 rounded bg-matrix-border text-matrix-bright font-bold flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layout" aria-hidden="true" class="lucide lucide-layout w-3 h-3 text-matrix-bright"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg> apps/scrov (Angular PWA)
        </button>
        <button onclick="setActiveApp('apps/shadowroot')" id="btn-app-shadowroot" class="px-2 py-0.5 rounded hover:bg-matrix-card text-emerald-500 hover:text-matrix-bright flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layers" aria-hidden="true" class="lucide lucide-layers w-3 h-3 text-matrix-neon"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg> apps/shadowroot (Wasmoon)
        </button>
        <button onclick="setActiveApp('apps/github-io')" id="btn-app-githubio" class="px-2 py-0.5 rounded hover:bg-matrix-card text-emerald-500 hover:text-matrix-bright flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="smartphone" aria-hidden="true" class="lucide lucide-smartphone w-3 h-3 text-matrix-amber"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg> apps/github-io (ADB)
        </button>
        <button onclick="setActiveApp('apps/api')" id="btn-app-api" class="px-2 py-0.5 rounded hover:bg-matrix-card text-emerald-500 hover:text-matrix-bright flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="database" aria-hidden="true" class="lucide lucide-database w-3 h-3 text-cyan-400"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg> apps/api (Cloudflare/Symfony)
        </button>
      </div>
    </div>

    <!-- Live Telemetry Badges & Quick Shortcuts -->
    <div class="flex items-center gap-2 text-xs font-mono">
      <div class="hidden sm:flex items-center gap-1 px-2 py-0.5 rounded bg-matrix-black border border-matrix-border text-matrix-bright">
        <span class="w-2 h-2 rounded-full bg-matrix-bright pulse-matrix"></span>
        <span class="text-[10px]">GEMINI:MCP</span>
      </div>
      <div class="hidden md:flex items-center gap-1 px-2 py-0.5 rounded bg-matrix-black border border-matrix-border text-matrix-neon">
