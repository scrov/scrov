    function handleTerminalCmd(cmd) {
      if (!cmd) { promptTerminal(); return; }
      const args = cmd.split(' ');
      const action = args[0].toLowerCase();

      switch (action) {
        case 'help':
          state.terminal.writeln('\x1b[1;33mAvailable Matrix Commands:\x1b[0m');
          state.terminal.writeln('  \x1b[32mmcp <tool>\x1b[0m           Execute MCP skill via Antigravity AgentAPI');
          state.terminal.writeln('  \x1b[32mgemini <prompt>\x1b[0m      Prompt Gemini Model MCP API directly');
          state.terminal.writeln('  \x1b[32mgh-mcp <cmd>\x1b[0m         Dispatch GitHub MCP command (X-GitHub-Api-Version: 2026-03-10)');
          state.terminal.writeln('  \x1b[32mcf-agent <cmd>\x1b[0m       Cloudflare Agent-Setup command execution');
          state.terminal.writeln('  \x1b[32madb shell <cmd>\x1b[0m      Send command to Android ADB device daemon');
          state.terminal.writeln('  \x1b[32mcurlpty <url>\x1b[0m        Simulate sub-millisecond HTTP/gRPC stream');
          state.terminal.writeln('  \x1b[32mnb.sh\x1b[0m                Run SQLite in-memory notebook query');
          state.terminal.writeln('  \x1b[32mclear\x1b[0m                Clear terminal display');
          break;
        case 'clear':
          state.terminal.clear();
          break;
        case 'gh-mcp':
          state.terminal.writeln('\x1b[36m[github-mcp-server] Connecting with X-GitHub-Api-Version: 2026-03-10...\x1b[0m');
          state.terminal.writeln('\x1b[32m[ok] Target: scrov/scrov (branch: main). Monorepo tools bound to Copilot Enterprise.\x1b[0m');
          break;
        case 'cf-agent':
          state.terminal.writeln('\x1b[33m[cf-agent-setup] Workers AI & Vectorize mesh online. D1 bindings active.\x1b[0m');
          break;
        case 'gemini':
          const prompt = args.slice(1).join(' ') || "Summarize active advertising campaigns";
          state.terminal.writeln(`\x1b[36m[gemini:mcp] Querying ${state.gemini.model}: "${prompt}"...\x1b[0m`);
          setTimeout(() => {
            state.terminal.writeln('\x1b[32m[gemini:response] Generated keyword recommendations and verified Law 25 compliance.\x1b[0m');
          }, 300);
          break;
        case 'curlpty':
          state.terminal.writeln('\x1b[36m* Connected to gateway.scrov.internal:80 (#0)\x1b[0m');
          state.terminal.writeln('\x1b[32m< HTTP/1.1 200 OK (Latency: 0.82ms)\x1b[0m');
          state.terminal.writeln('{"status":"UP","services":["envoy","lapis","quickjs","pglite","gemini-enterprise","github-mcp","cloudflare-agent"]}');
          break;
        default:
          state.terminal.writeln(`\x1b[31mbash: ${action}: command routed via container mesh.\x1b[0m`);
      }
      promptTerminal();
    }

