        <span class="text-[10px]">GADS:CMS</span>
      </div>
      <div class="hidden xl:flex items-center gap-1 px-2 py-0.5 rounded bg-matrix-black border border-matrix-border text-amber-400">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span class="text-[10px]">CF:WRANGLER</span>
      </div>

