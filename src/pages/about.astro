    function openVfsFile(filename) {
      for (const [folder, files] of Object.entries(state.vfs)) {
        if (files[filename]) {
          selectVfsFile(folder, filename);
          return;
        }
      }
    }

    function deleteVfsFile(folder, filename) {
      if (state.vfs[folder] && state.vfs[folder][filename]) {
        delete state.vfs[folder][filename];
        saveVfsToLocalStorage();
        renderVfsTree();
        logTerminal(`\x1b[31m[webdav] HTTP DELETE /dav/${folder}/${filename} -> 204 No Content\x1b[0m`);
        toast(`Deleted ${filename}`);
      }
    }

