{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scrov",
  "version": "2.0.0",
  "identifier": "app.scrov.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "cd .. && bun run build:web",
    "beforeBuildCommand": "cd .. && bun run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "scrov",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public": "public/"
    }
  }
}
