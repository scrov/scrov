{
  "name": "scrov",
  "type": "module",
  "version": "2.0.0",
  "description": "Terminal portfolio and blog rendered by Rust (Leptos SSR) on Cloudflare Workers.",
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@mcp-b/global": "^6.0.3",
    "@mcp-b/smart-dom-reader": "^6.0.3",
    "@mcp-b/smart-dom-reader-server": "^6.0.3",
    "@mcp-b/webmcp-polyfill": "^6.0.3",
    "@mcp-b/webmcp-ts-sdk": "^6.0.3",
    "chrome-devtools-mcp": "^1.12.0",
    "fengari-web": "^0.1.4",
    "htmx.org": "^2.0.4",
    "hyperscript.org": "^0.9.14",
    "oxc": "^1.0.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@nx/angular": "24.0.3",
    "@nx/workspace": "24.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "js-yaml": "^5.3.0",
    "nx": "24.0.3",
    "typescript": "^5.9.3",
    "wrangler": "4.88.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "scripts": {
    "assets": "bun run scripts/assets.ts",
    "css": "tailwindcss -i style/input.css -o public/pkg/app.css --minify",
    "build:client": "bash scripts/build-client.sh",
    "build:web": "bun run assets && bun run css && bun run build:client",
    "build:worker": "bash scripts/build-worker.sh",
    "update-prebuilt": "bash scripts/update-prebuilt.sh",
    "build": "bash scripts/build-worker.sh",
    "dev": "bun run build:web && cargo run -p scrov-server",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun run build:web && cargo test -p scrov-app -p scrov-server && cargo test -p scrov-client && bun test",
    "sync": "bun run scripts/sync.ts",
    "test": "bun test",
    "tauri": "cargo tauri"
  }
}
